# ============================================================================
# RAYHAN FITNESS — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env and replace placeholder secrets before deployment.
# NEVER commit your actual .env file to version control.

# PostgreSQL Relational Database Connection (Parameterized via Drizzle ORM)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# JWT Cryptographic Secrets (HS256 / Jose)
# Access Token TTL: 15 minutes | Refresh Token TTL: 7 days (HttpOnly, Secure, SameSite=Strict)
JWT_ACCESS_SECRET="replace-with-64-char-random-hex-secret-for-access-tokens"
JWT_REFRESH_SECRET="replace-with-64-char-random-hex-secret-for-refresh-tokens"
CSRF_SECRET="replace-with-32-char-random-hex-secret-for-csrf-tokens"

# Strict CORS Origin Whitelist (comma-separated trusted origins)
ALLOWED_ORIGINS="https://rayhanfitness.com,https://www.rayhanfitness.com,http://localhost:3000"

# Admin IP Restriction Optional Whitelist (leave empty to allow any IP with Admin 2FA/RBAC)
ADMIN_ALLOWED_IPS=""

# Payment Gateway Sandbox / Live Keys (bKash / Nagad / SSLCommerz)
BKASH_APP_KEY="sandbox_bkash_key"
NAGAD_MERCHANT_ID="sandbox_nagad_merchant"

# Security & Rate Limiting
RATE_LIMIT_MAX_AUTH_ATTEMPTS="10"
RATE_LIMIT_WINDOW_SECONDS="900"

# PWA / site URL / payment webhooks (see docs/DEPLOYMENT.md)
NEXT_PUBLIC_SITE_URL="https://rayhanfitness.com"
PAYMENT_WEBHOOK_SECRET="replace-with-gateway-webhook-hmac-secret"

# ============================================================================
# SUPABASE BACKEND — Postgres + Auth (Google/Facebook OAuth) + Storage
# Full walkthrough: supabase/README.md
# ============================================================================
# Project Settings → API → Project URL (public, safe for NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
# Project Settings → API → anon public key (public, RLS still enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-supabase-anon-public-key"
# Project Settings → API → service_role key — BACKEND-ONLY.
# NEVER prefix with NEXT_PUBLIC_, NEVER import in Client Components.
# Used only in src/lib/supabase/server.ts createAdminClient() inside
# Route Handlers / Server Actions. Leaking it bypasses ALL RLS policies.
SUPABASE_SERVICE_ROLE_KEY="replace-with-supabase-service-role-key-server-only"
#
# OAuth provider setup (paste into Supabase Dashboard → Authentication → Providers):
# - GOOGLE: Google Cloud Console → OAuth consent screen (scopes: openid, email,
#   profile only) → Credentials → OAuth client ID (Web) → redirect URI:
#     https://your-project-ref.supabase.co/auth/v1/callback
# - FACEBOOK: developers.facebook.com → App → Facebook Login product → same
#   redirect URI → permissions: email + public_profile only → switch app Live
# - Supabase → Authentication → URL Configuration → allowlist ONLY:
#     https://rayhanfitness.com/auth/callback
#     http://localhost:3000/auth/callback
# - Enable: Confirm-email, auth rate limits, hCaptcha (see supabase/README.md)
